# WorldForge 环境变量示例
# 规范前缀为 WORLDFORGE_<CAPABILITY>；WF_ 与 WORLDFORGE_BACKEND_ 为等价别名。
# 同时设置别名且取值不同会直接抛 ConfigError，不做静默取舍。

# --- 全局 ---
WORLDFORGE_SEED=1337
WORLDFORGE_LOG_LEVEL=INFO
WORLDFORGE_STRICT=false

# --- 检索参数 ---
WORLDFORGE_TOP_K=20
WORLDFORGE_RERANK_TOP_K=5
WORLDFORGE_CHUNK_SIZE=512
WORLDFORGE_CHUNK_OVERLAP=64
WORLDFORGE_FUSION=rrf
WORLDFORGE_RRF_K=60
WORLDFORGE_HYBRID=true
WORLDFORGE_BILINGUAL=true

# --- 后端选择（全部指向零依赖默认实现）---
WORLDFORGE_EMBEDDER=hashing
WORLDFORGE_VECTORSTORE=memory
WORLDFORGE_LEXICAL=bm25
WORLDFORGE_RERANKER=lexical
WORLDFORGE_LLM=mock
WORLDFORGE_DOCSTORE=memory
WORLDFORGE_OBSERVER=memory
WORLDFORGE_CHUNKER=recursive
WORLDFORGE_PLANNER=rule

# --- 服务 ---
WORLDFORGE_HOST=127.0.0.1
WORLDFORGE_PORT=8000
WORLDFORGE_TRACE_BUFFER=1000

# --- 生产后端连接（按需填写）---
# WORLDFORGE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# WORLDFORGE_LLM_MODEL=worldforge-mock-1
# WORLDFORGE_VECTOR_URL=http://127.0.0.1:6333
# WORLDFORGE_API_BASE=http://127.0.0.1:11434
# WORLDFORGE_API_KEY_ENV=OPENAI_API_KEY
# WORLDFORGE_SQLITE_PATH=data/worldforge.db
WORLDFORGE_STRICT_NOTE=设 STRICT=true 时后端不可用会直接报错而不是降级
